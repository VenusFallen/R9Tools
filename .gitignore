# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Runtime user config (created automatically from defaults on first run)
profiles.json

# Claude Code
.claude/

# PyInstaller
build/
dist/
*.spec
build.bat

# Installer build output
installer/

# Bundled third-party binaries (copy locally, don't commit)
installer_assets/

# Local assets (icons etc.)
assets/

# Inno Setup script (R9Tools.iss is tracked — it contains hand-written
# install/update logic, not just build config; other .iss files stay ignored)
*.iss
!R9Tools.iss

# LHM DLLs are bundled directly in lib/ and committed to the repo (MPL 2.0
# compliant, unmodified binaries) — nothing under lib/ is ignored.

# R9Tools runtime logs (only created here if the LOCALAPPDATA fallback triggers)
logs/
