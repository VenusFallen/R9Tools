# Python
__pycache__/
*.py[cod]
*.pyo

tests/

# Virtual environments
.venv/
venv/
env/

# Runtime user config (created automatically from defaults on first run)
profiles.json

# Claude Code
.claude/

# PyInstaller
build/
dist/
*.spec
build.bat

# Installer build output
installer/

# Bundled third-party binaries (copy locally, don't commit)
installer_assets/

# Local assets (icons etc.)
assets/

# Inno Setup script
*.iss

# LHM DLLs and runtime files (downloaded via auto-updater or manually)
lib/*.dll
lib/lhm_version.txt

# R9Tools runtime logs (only created here if the LOCALAPPDATA fallback triggers)
logs/
